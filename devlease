# ---------- helpers ----------

def err(msg=""):
    print(msg, file=sys.stderr)


def die(msg, code=1):
    err(f"devlease: {msg}")
    sys.exit(code)


def run(args, timeout=60, check=False):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout, check=check)
    except FileNotFoundError as e:
        return subprocess.CompletedProcess(args, 127, "", str(e))


def merge(base, override):
    for k, v in override.items():
        if isinstance(v, dict) and isinstance(base.get(k), dict):
            merge(base[k], v)
        else:
            base[k] = v
    return base


def read_user_config():
    if not CONFIG.exists():
        return {}
    try:
        return json.loads(CONFIG.read_text())
    except json.JSONDecodeError as e:
        die(f"{CONFIG} is not valid JSON: {e}")


def load_config():
    return merge(json.loads(json.dumps(DEFAULT_CONFIG)), read_user_config())


def save_user_config(user):
    STATE.mkdir(parents=True, exist_ok=True)
    write_json(CONFIG, user)


def set_config_value(key, value):
    """Persist one dotted key in the user config (only what the user changed is stored)."""
    user = read_user_config()
    node = user
    parts = key.split(".")
    for p in parts[:-1]:
        node = node.setdefault(p, {})
    node[parts[-1]] = value
    save_user_config(user)


def write_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n")
    tmp.replace(path)


@contextmanager
def state_lock():
    LEASES.mkdir(parents=True, exist_ok=True)
    LOGS.mkdir(parents=True, exist_ok=True)
    with open(STATE / "lock", "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


def adb():
    return shutil.which("adb") or str(SDK / "platform-tools/adb")


def emulator_bin():
    return str(SDK / "emulator/emulator")


def clone_tree(src, dst):
    """APFS copy-on-write clone (instant, no extra disk); plain copy on other file systems."""
    r = run(["cp", "-cR", str(src), str(dst)], timeout=600)
    if r.returncode != 0:
        if Path(dst).exists():
            shutil.rmtree(dst)
        r = run(["cp", "-R", str(src), str(dst)], timeout=1800)
        if r.returncode != 0:
            die(f"copying {src} failed: {r.stderr.strip()}")


# ---------- owner identity ----------

def _names(comm, args):
    names = {os.path.basename(comm)}
    argv = args.split()
    if argv:
        first = os.path.basename(argv[0])
        names.add(first)
        if first in INTERPRETERS:
            script = next((a for a in argv[1:] if not a.startswith("-")), "")
            names.add(re.sub(r"\.(c|m)?js$", "", os.path.basename(script)))
    return names


def process_table():
    """pid -> (ppid, {names})"""
    comms = {}
    for line in run(["ps", "-axo", "pid=,comm="]).stdout.splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) == 2:
            comms[int(parts[0])] = parts[1]
    table = {}
    for line in run(["ps", "-axww", "-o", "pid=,ppid=,args="]).stdout.splitlines():
        parts = line.strip().split(None, 2)
        if len(parts) >= 2:
            pid, ppid = int(parts[0]), int(parts[1])
            table[pid] = (ppid, _names(comms.get(pid, ""), parts[2] if len(parts) == 3 else ""))
    return table


def agent_names():
    try:
        extra = load_config().get("agent_names") or []
    except SystemExit:
        extra = []
    return tuple(AGENT_NAMES) + tuple(extra)


def is_agent(names):
    known = agent_names()
    return any(name == n or name.startswith(n + "-") or name.startswith(n + ".") for name in names for n in known)


def agent_pid():
    if os.environ.get("DEVLEASE_OWNER_PID"):
        return int(os.environ["DEVLEASE_OWNER_PID"])
    table = process_table()
    pid = os.getppid()
    seen = set()
    while pid > 1 and pid not in seen:
        seen.add(pid)
        entry = table.get(pid)
        if not entry:
            break
        if is_agent(entry[1]):
            return pid
        pid = entry[0]
    return None


def worktree(cwd=None):
    cwd = cwd or os.getcwd()
    r = run(["git", "-C", cwd, "rev-parse", "--show-toplevel"])
    return r.stdout.strip() if r.returncode == 0 else os.path.abspath(cwd)


def current_owner(cwd=None):
    return {"agent_pid": agent_pid(), "worktree": worktree(cwd)}


def owns(lease, owner):
    if owner["agent_pid"] is not None:
        return lease.get("agent_pid") == owner["agent_pid"]
    return lease.get("agent_pid") is None and lease.get("worktree") == owner["worktree"]


def pid_alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    if os.environ.get("DEVLEASE_OWNER_PID") == str(pid):
        return True
    comm = run(["ps", "-p", str(pid), "-o", "comm="]).stdout.strip()
    args = run(["ps", "-ww", "-p", str(pid), "-o", "args="]).stdout.strip()
    return bool(comm) and is_agent(_names(comm, args))


# ---------- leases ----------

def lease_path(platform, slot):
    return LEASES / f"{platform}-{slot}.json"


def all_leases():
    leases = []
    if LEASES.exists():
        for p in sorted(LEASES.glob("*.json")):
            try:
                leases.append(json.loads(p.read_text()))
            except (OSError, json.JSONDecodeError):
                pass
    return leases


def owner_leases(owner, platform=None):
    return [l for l in all_leases() if owns(l, owner) and (platform is None or l["platform"] == platform)]


def drop_lease(lease):
    lease_path(lease["platform"], lease["slot"]).unlink(missing_ok=True)


def mcp_id(lease):
    return lease.get("mcp_id") or lease.get("device")


# ---------- device state ----------

def adb_serials():
    out = run([adb(), "devices"]).stdout
    return {line.split()[0] for line in out.splitlines()[1:] if line.strip()}


def simctl_json(*what):
    if not shutil.which("xcrun"):
        return {}
    out = run(["xcrun", "simctl", "list", *what, "-j"], timeout=60).stdout
    try:
        return json.loads(out or "{}")
    except json.JSONDecodeError:
        return {}


def sim_devices():
    devices = {}
    for runtime, runtime_devices in simctl_json("devices").get("devices", {}).items():
        for d in runtime_devices:
            devices[d["udid"]] = dict(d, runtime=runtime)
    return devices


def device_alive(lease, serials, sims):
    if lease["platform"] == "android":
        return lease.get("device") in serials
    d = sims.get(lease.get("device") or "")
    return d is not None and d.get("state") == "Booted"


def port_free(port):
    for p in (port, port + 1):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.settimeout(0.3)
            if s.connect_ex(("127.0.0.1", p)) == 0:
                return False
    return True


def stop_device(lease):
    device = lease.get("device")
    if lease["platform"] == "android":
        if device:
            run([adb(), "-s", device, "emu", "kill"], timeout=20)
            for _ in range(20):
                if device not in adb_serials():
                    break
                time.sleep(1)
        pid = lease.get("emulator_pid")
        if pid:
            try:
                os.kill(pid, 15)
            except (ProcessLookupError, PermissionError):
                pass
    else:
        target = device or f"{SLOT_SIM_PREFIX}{lease['slot']}"
        run(["xcrun", "simctl", "shutdown", target], timeout=60)
        run(["xcrun", "simctl", "delete", target], timeout=60)


def reap(verbose=False):
    """Free stale leases and orphaned devices. Caller holds the state lock."""
    cfg = load_config()
    serials = adb_serials() if Path(adb()).exists() else set()
    sims = sim_devices()
    now = time.time()
    freed = []
    for lease in all_leases():
        booting = lease.get("state") == "booting" and now - lease.get("acquired_at", 0) < BOOT_GRACE_S
        reason = None
        if lease.get("agent_pid") is not None and not pid_alive(lease["agent_pid"]):
            reason = "owner process exited"
        elif lease.get("agent_pid") is None and lease.get("worktree") and not os.path.isdir(lease["worktree"]):
            reason = "worktree removed"
        elif not booting and not device_alive(lease, serials, sims):
            reason = "device no longer running"
        if reason:
            stop_device(lease)
            drop_lease(lease)
            freed.append((lease, reason))
            if verbose:
                err(f"devlease: freed {lease['platform']}-{lease['slot']} ({lease.get('device')}): {reason}")
    # Orphans: emulators on lease ports / lease-ios-* simulators without a lease file.
    leased = {(l["platform"], l["slot"]) for l in all_leases()}
    a = cfg["android"]
    for slot in range(a["slots"]):
        serial = f"emulator-{a['base_port'] + 2 * slot}"
        if ("android", slot) not in leased and serial in serials:
            stop_device({"platform": "android", "slot": slot, "device": serial})
    for udid, d in sims.items():
        m = re.fullmatch(re.escape(SLOT_SIM_PREFIX) + r"(\d+)", d.get("name", ""))
        if m and ("ios", int(m.group(1))) not in leased:
            stop_device({"platform": "ios", "slot": int(m.group(1)), "device": udid})
    return freed


# ---------- Android masters and slots ----------

def slot_avd_name(slot):
    return f"{SLOT_AVD_PREFIX}{slot}"


def avd_exists(name):
    return (AVD_HOME / f"{name}.ini").exists() and (AVD_HOME / f"{name}.avd").is_dir()


def delete_avd(name):
    shutil.rmtree(AVD_HOME / f"{name}.avd", ignore_errors=True)
    (AVD_HOME / f"{name}.ini").unlink(missing_ok=True)


def lease_avds(cfg):
    """All AVDs devlease created: the master and every slot AVD (also leftovers beyond `slots`)."""
    names = []
    if AVD_HOME.is_dir():
        for ini in sorted(AVD_HOME.glob("*.ini")):
            n = ini.stem
            if n == cfg["android"]["master_avd"] or re.fullmatch(re.escape(SLOT_AVD_PREFIX) + r"\d+", n):
                names.append(n)
    return names


def master_running_android(cfg):
    out = run(["ps", "-axww", "-o", "command="]).stdout
    avds = [cfg["android"]["master_avd"]] + [slot_avd_name(i) for i in range(cfg["android"]["slots"])]
    return any(f"-avd {avd} " in l + " " and "-read-only" not in l and "qemu" in l
               for l in out.splitlines() for avd in avds)


def host_abi():
    return "arm64-v8a" if host_platform.machine() in ("arm64", "aarch64") else "x86_64"


def read_props(path):
    props = {}
    if path.exists():
        for line in path.read_text(errors="replace").splitlines():
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                props[k.strip()] = v.strip()
    return props


def installed_system_images():
    """[(api_level, tag_rank, rel_path, props)] for phone images matching the host ABI, best first."""
    tag_rank = {"google_apis_playstore": 0, "google_apis": 1, "default": 2}
    images = []
    root = SDK / "system-images"
    if not root.is_dir():
        return images
    for d in root.glob("*/*/*"):
        if d.name != host_abi() or not (d / "source.properties").exists():
            continue
        tag = d.parent.name
        if any(x in tag for x in ("wear", "tv", "automotive", "desktop", "xr")):
            continue
        props = read_props(d / "source.properties")
        try:
            api = float(props.get("AndroidVersion.ApiLevel") or re.sub(r"[^0-9.]", "", d.parent.parent.name) or 0)
        except ValueError:
            api = 0
        images.append((api, tag_rank.get(tag, 9), f"system-images/{d.parent.parent.name}/{tag}/{d.name}/", props))
    images.sort(key=lambda i: (-i[0], i[1]))
    return images


def resolve_system_image(cfg):
    want = cfg["android"].get("system_image")
    if want:
        rel = want.replace(";", "/").strip("/") + "/"
        if not (SDK / rel).is_dir():
            die(f"system image {want} is not installed in {SDK}. Install it with Android Studio's SDK Manager "
                f"or `sdkmanager \"{want.replace('/', ';').strip(';')}\"`.")
        props = read_props(SDK / rel / "source.properties")
        api = float(props.get("AndroidVersion.ApiLevel") or 0)
        return api, rel, props
    images = installed_system_images()
    if not images:
        die(f"no {host_abi()} phone system image found in {SDK}/system-images. Install one in Android Studio "
            "(Settings > Languages & Frameworks > Android SDK > SDK Platforms > a Google Play image), "
            "or set android.template_avd to an AVD you already have.")
    api, _, rel, props = images[0]
    return api, rel, props


def write_config_ini(path, values):
    path.write_text("".join(f"{k}={v}\n" for k, v in values.items()))


def create_master_avd(cfg):
    a = cfg["android"]
    name = a["master_avd"]
    avd_dir = AVD_HOME / f"{name}.avd"
    AVD_HOME.mkdir(parents=True, exist_ok=True)
    if a.get("template_avd"):
        template = AVD_HOME / f"{a['template_avd']}.avd/config.ini"
        if not template.exists():
            die(f"template AVD config {template} not found (android.template_avd = {a['template_avd']!r})")
        values = read_props(template)
        source = f"template AVD {a['template_avd']}"
    else:
        api, rel, props = resolve_system_image(cfg)
        tag = props.get("SystemImage.TagId") or rel.split("/")[2]
        api_str = str(int(api)) if api == int(api) else str(api)
        display = props.get("SystemImage.TagDisplay", tag)
        values = {
            "avd.ini.encoding": "UTF-8",
            "PlayStore.enabled": "true" if tag == "google_apis_playstore" else "false",
            "abi.type": host_abi(),
            "hw.cpu.arch": "arm64" if host_abi() == "arm64-v8a" else "x86_64",
            "image.sysdir.1": rel,
            "tag.id": tag, "tag.ids": tag, "tag.display": display, "tag.displaynames": display,
            "target": f"android-{api_str}",
        }
        values.update(PHONE_PROFILE)
        source = rel.rstrip("/")
    values["AvdId"] = name
    values["avd.ini.displayname"] = name
    values["hw.gpu.enabled"] = "yes"
    values["hw.gpu.mode"] = "host"
    values.update({k: str(v) for k, v in (a.get("avd_config") or {}).items()})
    avd_dir.mkdir(parents=True)
    write_config_ini(avd_dir / "config.ini", values)
    target = values.get("target", "android-36")
    (AVD_HOME / f"{name}.ini").write_text(
        f"avd.ini.encoding=UTF-8\npath={avd_dir}\npath.rel=avd/{name}.avd\ntarget={target}\n")
    err(f"devlease: created master AVD {name} from {source} (hardware graphics acceleration)")


def boot_master_window(avd):
    err(f"devlease: {avd} is starting in a window. Set it up the way every leased device should start\n"
        "  (sign-ins, settings, apps, developer options...), then close the emulator window.\n"
        "  Slot devices are rebuilt from it afterwards.")
    LOGS.mkdir(parents=True, exist_ok=True)
    with open(LOGS / "master-android.log", "w") as log:
        r = subprocess.run([emulator_bin(), "-avd", avd, "-no-audio", "-no-boot-anim"],
                           stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
    if r.returncode != 0:
        err(f"devlease: emulator exited with code {r.returncode}; see {LOGS / 'master-android.log'}")


def snapshot_avd(cfg, avd, log_name):
    """Boot an AVD headless (not read-only) and shut it down so its quick-boot snapshot is saved."""
    port = cfg["android"]["snapshot_port"]
    serial = f"emulator-{port}"
    if not port_free(port):
        die(f"port {port} (android.snapshot_port, used for snapshotting) is busy")
    LOGS.mkdir(parents=True, exist_ok=True)
    log = open(LOGS / log_name, "w")
    proc = subprocess.Popen([emulator_bin(), "-avd", avd, "-no-audio", "-no-boot-anim", "-no-window", "-port", str(port)],
                            stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)
    deadline = time.time() + 600
    while time.time() < deadline:
        if proc.poll() is not None:
            die(f"{avd} exited while booting; see {LOGS / log_name}")
        if run([adb(), "-s", serial, "shell", "getprop", "sys.boot_completed"], timeout=15).stdout.strip() == "1":
            break
        time.sleep(3)
    else:
        proc.terminate()
        die(f"{avd} did not boot in 10 min; see {LOGS / log_name}")
    time.sleep(20)  # let first-boot services settle before snapshotting
    run([adb(), "-s", serial, "emu", "kill"], timeout=30)
    proc.wait(timeout=180)
    if not (AVD_HOME / f"{avd}.avd/snapshots/default_boot").exists():
        die(f"{avd}: quick-boot snapshot was not saved; see {LOGS / log_name}")


def build_slot_avd(cfg, slot):
    """Slot AVD = clone of the master with its own name and its own snapshot.

    Mobile MCP (mobilecli) identifies emulators by ro.boot.qemu.avd_name, which a snapshot restores
    from RAM, so each slot needs a distinct AVD whose snapshot was taken under its own name.
    """
    a = cfg["android"]
    name = slot_avd_name(slot)
    master_dir = AVD_HOME / f"{a['master_avd']}.avd"
    avd_dir = AVD_HOME / f"{name}.avd"
    if avd_dir.exists():
        shutil.rmtree(avd_dir)
    clone_tree(master_dir, avd_dir)
    for leftover in ("snapshots", "hardware-qemu.ini", "emu-launch-params.txt", "initrd", "read-snapshot.txt",
                     "snapshot.trace", "bootcompleted.ini", "multiinstance.lock", "tmpAdbCmds"):
        path = avd_dir / leftover
        if path.is_dir():
            shutil.rmtree(path)
        else:
            path.unlink(missing_ok=True)
    for lock in avd_dir.glob("*.lock"):
        shutil.rmtree(lock) if lock.is_dir() else lock.unlink()
    config = []
    for line in (master_dir / "config.ini").read_text().splitlines():
        if line.startswith("AvdId="):
            line = f"AvdId={name}"
        elif line.startswith("avd.ini.displayname="):
            line = f"avd.ini.displayname={name}"
        config.append(line)
    (avd_dir / "config.ini").write_text("\n".join(config) + "\n")
    ini = (AVD_HOME / f"{a['master_avd']}.ini").read_text().replace(f"{a['master_avd']}.avd", f"{name}.avd")
    (AVD_HOME / f"{name}.ini").write_text(ini)
    snapshot_avd(cfg, name, f"slot-android-{slot}.log")
    err(f"devlease: built slot AVD {name}")


def rebuild_android(cfg):
    a = cfg["android"]
    if not avd_exists(a["master_avd"]):
        die(f"master AVD {a['master_avd']} not found; run `devlease init android`")
    if master_running_android(cfg):
        die(f"master AVD {a['master_avd']} is running; close it first")
    for slot in range(a["slots"]):
        build_slot_avd(cfg, slot)
    for name in lease_avds(cfg):
        m = re.fullmatch(re.escape(SLOT_AVD_PREFIX) + r"(\d+)", name)
        if m and int(m.group(1)) >= a["slots"]:
            delete_avd(name)
            err(f"devlease: deleted surplus slot AVD {name}")
    err(f"devlease: {a['slots']} Android slot(s) ready")


def boot_android(cfg, slot):
    a = cfg["android"]
    if master_running_android(cfg):
        raise RuntimeError(f"master AVD {a['master_avd']} is running normally; close it first")
    port = a["base_port"] + 2 * slot
    if not port_free(port):
        raise RuntimeError(f"port {port} is in use")
    serial = f"emulator-{port}"
    avd = slot_avd_name(slot)
    if not (AVD_HOME / f"{avd}.avd/snapshots/default_boot").exists():
        raise RuntimeError(f"slot AVD {avd} missing; ask the user to run `devlease init android` "
                           "(or `devlease rebuild android`)")
    update_lease("android", slot, mcp_id=avd)
    args = [emulator_bin(), "-avd", avd, "-read-only", "-port", str(port), "-no-audio", "-no-boot-anim"]
    if a.get("headless", True):
        args.append("-no-window")
    log = open(LOGS / f"android-{slot}.log", "w")
    proc = subprocess.Popen(args, stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)
    update_lease("android", slot, device=serial, emulator_pid=proc.pid)
    deadline = time.time() + a["boot_timeout_s"]
    while time.time() < deadline:
        if proc.poll() is not None:
            raise RuntimeError(f"emulator exited (code {proc.returncode}); see {LOGS / f'android-{slot}.log'}")
        r = run([adb(), "-s", serial, "shell", "getprop", "sys.boot_completed"], timeout=15)
        if r.stdout.strip() == "1":
            return serial
        time.sleep(2)
    raise RuntimeError(f"{serial} did not finish booting in {a['boot_timeout_s']} s")


# ---------- iOS master ----------

def resolve_ios_target(cfg):
    i = cfg["ios"]
    runtime, device_type = i.get("runtime"), i.get("device_type")
    runtimes = [r for r in simctl_json("runtimes").get("runtimes", [])
                if r.get("isAvailable") and r.get("platform", "iOS") == "iOS" and "iOS" in r.get("name", "iOS")]
    if not runtime:
        if not runtimes:
            die("no iOS simulator runtime installed; install one in Xcode > Settings > Components")
        best = max(runtimes, key=lambda r: [int(x) for x in re.findall(r"\d+", r.get("version", "0"))])
        runtime = best["identifier"]
    if not device_type:
        rt = next((r for r in runtimes if r["identifier"] == runtime), None)
        types = (rt or {}).get("supportedDeviceTypes") or simctl_json("devicetypes").get("devicetypes", [])
        iphones = [t for t in types if t.get("productFamily", "iPhone") == "iPhone" and t.get("name", "").startswith("iPhone")]
        if not iphones:
            die(f"no iPhone device type for runtime {runtime}; set ios.device_type")

        def rank(t):
            n = t["name"]
            num = [int(x) for x in re.findall(r"\d+", n)] or [0]
            return (num[0], n.endswith(" Pro"), "Pro Max" not in n and "Plus" not in n)
        device_type = max(iphones, key=rank)["identifier"]
    return device_type, runtime


def ios_master(cfg):
    """The iOS master's UDID. If the config lost it (e.g. state was deleted but devices kept), adopt
    the simulator named like the master and remember it."""
    sims = sim_devices()
    udid = cfg["ios"].get("master_udid")
    if udid and udid in sims:
        return udid
    named = [u for u, d in sims.items() if d.get("name") == cfg["ios"]["master_name"]]
    if len(named) == 1:
        set_config_value("ios.master_udid", named[0])
        cfg["ios"]["master_udid"] = named[0]
        return named[0]
    return None


def create_ios_master(cfg):
    i = cfg["ios"]
    device_type, runtime = resolve_ios_target(cfg)
    r = run(["xcrun", "simctl", "create", i["master_name"], device_type, runtime], timeout=120)
    if r.returncode != 0:
        die(f"simctl create failed: {r.stderr.strip()}")
    udid = r.stdout.strip()
    set_config_value("ios.master_udid", udid)
    err(f"devlease: created simulator {i['master_name']} ({udid}, {device_type.rsplit('.', 1)[-1]}, "
        f"{runtime.rsplit('.', 1)[-1]})")
    return udid


def ios_boot_once(udid):
    run(["xcrun", "simctl", "boot", udid], timeout=120)
    run(["xcrun", "simctl", "bootstatus", udid, "-b"], timeout=600)
    run(["xcrun", "simctl", "shutdown", udid], timeout=120)


def ios_setup_window(udid):
    run(["xcrun", "simctl", "boot", udid], timeout=120)
    run(["xcrun", "simctl", "bootstatus", udid, "-b"], timeout=600)
    run(["open", "-a", "Simulator", "--args", "-CurrentDeviceUDID", udid])
    err("devlease: the iOS master is open in Simulator. Set it up the way every leased device should start\n"
        "  (sign-ins, settings, apps...). When done, shut it down: close its window or quit Simulator, or run\n"
        f"  `xcrun simctl shutdown {udid}`. Waiting for it to shut down...")
    while True:
        d = sim_devices().get(udid)
        if not d or d.get("state") == "Shutdown":
            break
        time.sleep(3)
    err("devlease: iOS master shut down; leased simulators are cloned from it from now on")


def boot_ios(cfg, slot):
    i = cfg["ios"]
    master = i.get("master_udid")
    sims = sim_devices()
    if not master or master not in sims:
        raise RuntimeError("iOS master simulator missing; ask the user to run `devlease init ios`")
    if sims[master].get("state") != "Shutdown":
        raise RuntimeError(f"iOS master simulator {master} is {sims[master].get('state')}; shut it down first")
    name = f"{SLOT_SIM_PREFIX}{slot}"
    r = run(["xcrun", "simctl", "clone", master, name], timeout=180)
    if r.returncode != 0:
        raise RuntimeError(f"simctl clone failed: {r.stderr.strip()}")
    udid = r.stdout.strip()
    update_lease("ios", slot, device=udid)
    run(["xcrun", "simctl", "boot", udid], timeout=120)
    r = run(["xcrun", "simctl", "bootstatus", udid, "-b"], timeout=300)
    if r.returncode != 0:
        raise RuntimeError(f"simctl bootstatus failed: {r.stderr.strip()}")
    return udid


def update_lease(platform, slot, **fields):
    with state_lock():
        path = lease_path(platform, slot)
        if path.exists():
            lease = json.loads(path.read_text())
            lease.update(fields)
            write_json(path, lease)


# ---------- lease commands ----------

def cmd_acquire(args):
    cfg = load_config()
    platform = args.platform
    owner = current_owner()
    deadline = time.time() + args.timeout
    announced = False
    while True:
        with state_lock():
            reap(verbose=True)
            mine = owner_leases(owner, platform)
            if mine:
                lease = mine[0]
                if lease.get("state") == "ready":
                    err(f"devlease: you already hold {platform}-{lease['slot']} (MCP device id: {mcp_id(lease)})")
                    print(lease["device"])
                    return 0
                die(f"a lease for this owner is still booting ({platform}-{lease['slot']})")
            taken = {l["slot"] for l in all_leases() if l["platform"] == platform}
            free = [s for s in range(cfg[platform]["slots"]) if s not in taken]
            if free:
                slot = free[0]
                write_json(lease_path(platform, slot), {
                    "platform": platform, "slot": slot, "device": None, "state": "booting",
                    "agent_pid": owner["agent_pid"], "worktree": owner["worktree"], "acquired_at": time.time(),
                })
                break
        if not args.wait:
            err(f"devlease: all {platform} slots are taken (use --wait to wait for one)")
            print_status(sys.stderr)
            return 3
        if time.time() > deadline:
            die(f"timed out waiting for a free {platform} slot", 3)
        if not announced:
            err(f"devlease: all {platform} slots taken, waiting...")
            announced = True
        time.sleep(5)

    started = time.time()
    try:
        device = boot_android(cfg, slot) if platform == "android" else boot_ios(cfg, slot)
    except Exception as e:
        with state_lock():
            path = lease_path(platform, slot)
            if path.exists():
                lease = json.loads(path.read_text())
                stop_device(lease)
                drop_lease(lease)
        die(str(e))
    update_lease(platform, slot, state="ready", device=device)
    mcp = slot_avd_name(slot) if platform == "android" else device
    err(f"devlease: {platform}-{slot} ready in {time.time() - started:.0f} s "
        f"({'serial' if platform == 'android' else 'UDID'} {device}, MCP device id: {mcp})")
    print(device)
    return 0


def cmd_release(args):
    with state_lock():
        if args.device:
            targets = [l for l in all_leases() if l.get("device") == args.device or l.get("mcp_id") == args.device]
        elif args.owner_pid:
            targets = [l for l in all_leases() if l.get("agent_pid") == args.owner_pid]
        elif args.all:
            targets = all_leases()
        else:
            targets = owner_leases(current_owner(), args.platform)
        for lease in targets:
            stop_device(lease)
            drop_lease(lease)
            err(f"devlease: released {lease['platform']}-{lease['slot']} ({lease.get('device')})")
        if not targets:
            err("devlease: nothing to release")
    return 0


def cmd_mine(args):
    for lease in owner_leases(current_owner(), args.platform):
        if lease.get("state") == "ready":
            print(f"{lease['platform']}\t{lease['device']}\tmcp: {mcp_id(lease)}")
    return 0


def print_status(out=sys.stdout):
    cfg = load_config()
    leases = {(l["platform"], l["slot"]): l for l in all_leases()}
    now = time.time()
    for platform in ("android", "ios"):
        for slot in range(cfg[platform]["slots"]):
            l = leases.get((platform, slot))
            if not l:
                print(f"{platform}-{slot}\tfree", file=out)
                continue
            age = int((now - l.get("acquired_at", now)) / 60)
            pid = l.get("agent_pid")
            alive = "alive" if pid is None or pid_alive(pid) else "dead"
            print(f"{platform}-{slot}\t{l.get('state')}\t{l.get('device')}\tmcp: {mcp_id(l)}\tpid={pid} ({alive})"
                  f"\t{age} min\t{l.get('worktree')}", file=out)


def cmd_status(args):
    with state_lock():
        reap(verbose=True)
    print_status()
    return 0


def cmd_reap(args):
    with state_lock():
        freed = reap(verbose=True)
    if not freed:
        err("devlease: nothing stale")
    return 0


# ---------- master commands ----------

def require_no_leases():
    with state_lock():
        reap()
        if all_leases():
            die("devices are leased right now; they must be released before the master changes "
                "(`devlease status` shows who holds them)")


def cmd_init(args):
    cfg = load_config()
    require_no_leases()
    if args.platform == "android":
        name = cfg["android"]["master_avd"]
        if avd_exists(name):
            if not args.force:
                die(f"master AVD {name} already exists. Use `devlease edit android` to change its data, "
                    "or `devlease init android --force` to delete it and start fresh.")
            for n in lease_avds(cfg):
                delete_avd(n)
            err(f"devlease: deleted {name} and its slots")
        create_master_avd(cfg)
        if not args.no_setup:
            boot_master_window(name)
        rebuild_android(cfg)
    else:
        udid = ios_master(cfg)
        if udid:
            if not args.force:
                die(f"iOS master {udid} already exists. Use `devlease edit ios` to change its data, "
                    "or `devlease init ios --force` to delete it and start fresh.")
            run(["xcrun", "simctl", "shutdown", udid], timeout=60)
            run(["xcrun", "simctl", "delete", udid], timeout=60)
            err(f"devlease: deleted iOS master {udid}")
        udid = create_ios_master(cfg)
        if args.no_setup:
            ios_boot_once(udid)
        else:
            ios_setup_window(udid)
        err(f"devlease: iOS master ready ({cfg['ios']['slots']} slot(s); simulators are cloned at lease time)")
    err(f"devlease: agents can now run `devlease acquire {args.platform} --wait`")
    return 0


def cmd_edit(args):
    cfg = load_config()
    require_no_leases()
    if args.platform == "android":
        name = cfg["android"]["master_avd"]
        if not avd_exists(name):
            die(f"master AVD {name} not found; run `devlease init android` first")
        if master_running_android(cfg):
            die(f"{name} is already running; close it first")
        boot_master_window(name)
        rebuild_android(cfg)
    else:
        udid = ios_master(cfg)
        if not udid:
            die("iOS master not found; run `devlease init ios` first")
        ios_setup_window(udid)
    return 0


def cmd_rebuild(args):
    cfg = load_config()
    require_no_leases()
    if args.platform == "android":
        rebuild_android(cfg)
    else:
        if not ios_master(cfg):
            die("iOS master not found; run `devlease init ios` first")
        err("devlease: nothing to rebuild for iOS: leased simulators are cloned from the master at lease time")
    return 0


def cmd_master(args):
    """Deprecated alias kept for older instructions."""
    cfg = load_config()
    exists = avd_exists(cfg["android"]["master_avd"]) if args.platform == "android" else bool(ios_master(cfg))
    args.force = False
    if args.setup:
        err("devlease: `master --setup` is deprecated; use `devlease init` / `devlease edit`")
        args.no_setup = False
        return cmd_edit(args) if exists else cmd_init(args)
    err("devlease: `master` is deprecated; use `devlease rebuild` (or `devlease init` for a new master)")
    if not exists:
        args.no_setup = True
        return cmd_init(args)
    return cmd_rebuild(args)


