# ---------- guard (hook) logic ----------

WRAPPERS = {"env", "time", "nohup", "sudo", "command", "exec", "nice", "caffeinate", "timeout", "gtimeout"}
ASSIGN = re.compile(r"^([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
HEREDOC = re.compile(r"<<-?\s*(['\"]?)([A-Za-z_][A-Za-z0-9_]*)\1")
DEVICE_WORDS = re.compile(r"adb|gradle|simctl|xcodebuild|emulator|flutter|maestro")


def strip_heredocs(command):
    """Drop heredoc bodies: they are data (file contents, scripts), not commands to check."""
    out = []
    lines = command.split("\n")
    i = 0
    while i < len(lines):
        line = lines[i]
        out.append(line)
        delimiters = [m.group(2) for m in HEREDOC.finditer(line)]
        i += 1
        for d in delimiters:
            while i < len(lines) and lines[i].strip() != d:
                i += 1
            i += 1
    return "\n".join(out)


def split_segments(command):
    """Split at ; & | && || and newlines outside quotes."""
    segments, cur, quote, i = [], [], None, 0
    text = strip_heredocs(command)
    while i < len(text):
        c = text[i]
        if quote:
            if c == "\\" and quote == '"' and i + 1 < len(text):
                cur.append(text[i:i + 2])
                i += 2
                continue
            if c == quote:
                quote = None
            cur.append(c)
        elif c == "\\" and i + 1 < len(text):
            cur.append(text[i:i + 2])
            i += 2
            continue
        elif c in "'\"":
            quote = c
            cur.append(c)
        elif c in ";|\n" or (c == "&" and not text[i + 1:i + 2] == ">" and not text[i - 1:i] in (">", "<")):
            segments.append("".join(cur))
            cur = []
        else:
            cur.append(c)
        i += 1
    segments.append("".join(cur))
    return [s.strip() for s in segments if s.strip()]


def tokenize(segment):
    try:
        return shlex.split(segment, comments=True)
    except ValueError:
        return segment.split()


def is_var(token):
    """`$VAR` / `${VAR}`: can't be resolved here, so trust it when the session holds a lease."""
    return bool(token) and re.fullmatch(r"\$\{?[A-Za-z_][A-Za-z0-9_]*\}?", token) is not None


def protected_msg(serial):
    return f"{serial} is a protected device (protected_serials); never use it"


def check_serial(serial, leased_set, protected, what):
    if serial in protected:
        return protected_msg(serial)
    if serial not in leased_set and not (is_var(serial) and leased_set):
        return f"{what} {serial}, which this session has not leased"
    return None


def flag_value(rest, names):
    for i, t in enumerate(rest):
        if t in names and i + 1 < len(rest):
            return rest[i + 1]
        for n in names:
            if n.startswith("--") and t.startswith(n + "="):
                return t.split("=", 1)[1]
    return None


def check_segment(tokens, env, leased, protected):
    """Return a block reason or None. `env` carries exports from earlier segments."""
    tokens = list(tokens)
    local_env = dict(env)
    while tokens and (ASSIGN.match(tokens[0]) or os.path.basename(tokens[0]) in WRAPPERS
                      or tokens[0].startswith("-") or re.fullmatch(r"\d+(\.\d+)?[smhd]?", tokens[0])):
        m = ASSIGN.match(tokens[0])
        if m:
            local_env[m.group(1)] = m.group(2)
        tokens.pop(0)
    if not tokens:
        return None
    prog = os.path.basename(tokens[0])
    rest = tokens[1:]
    android = leased["android"]
    ios = leased["ios"]

    if prog == "export":
        for t in rest:
            m = ASSIGN.match(t)
            if m:
                env[m.group(1)] = m.group(2)
        return None
    if prog in ("bash", "sh", "zsh") and "-c" in rest:
        i = rest.index("-c")
        if i + 1 < len(rest):
            return check_command(rest[i + 1], leased, protected, env)
        return None
    if prog == "devlease":
        return None

    if prog == "adb":
        serial = local_env.get("ANDROID_SERIAL")
        sub = None
        i = 0
        while i < len(rest):
            t = rest[i]
            if t == "-s" and i + 1 < len(rest):
                serial = rest[i + 1]
                i += 2
                continue
            if t in ("-d", "-e"):
                return f"`adb {t}` picks an arbitrary device; use `adb -s <your serial>`"
            if t in ("-H", "-P", "-L", "-t") and i + 1 < len(rest):
                i += 2
                continue
            if t.startswith("-"):
                i += 1
                continue
            sub = t
            break
        if sub == "kill-server":
            return "`adb kill-server` disconnects every agent's devices"
        if sub in (None, "devices", "version", "start-server", "help", "--help", "keygen"):
            return None
        if not serial:
            return "adb needs a device: use `adb -s <serial>` (or ANDROID_SERIAL=<serial>)"
        return check_serial(serial, android, protected, "adb targets")

    if prog in ("gradlew", "gradle"):
        tasks = [t for t in rest if not t.startswith("-")]
        device_task = re.compile(r"(^|:)(install|uninstall)[A-Za-z0-9]*$|(^|:)connected[A-Za-z0-9]*(Test|Check)$")
        if any(device_task.search(t) for t in tasks):
            serial = local_env.get("ANDROID_SERIAL")
            if not serial:
                return "Gradle install/connected tasks hit every connected device; prefix with ANDROID_SERIAL=<serial>"
            return check_serial(serial, android, protected, "ANDROID_SERIAL is")
        return None

    if prog == "simctl" or (prog == "xcrun" and "simctl" in rest):
        args = rest[rest.index("simctl") + 1:] if prog == "xcrun" else rest
        args = [a for a in args if not a.startswith("-") or a == "-j"]
        sub = args[0] if args else None
        if sub in (None, "list", "help", "runtime", "getenv", "create"):
            return None
        if "booted" in args[1:] or "all" in args[1:]:
            return "simctl `booted`/`all` can hit other agents' simulators; pass your leased UDID"
        udids = UUID_RE.findall(" ".join(args[1:]))
        if not udids:
            if ios and any(is_var(a) for a in args[1:]):
                return None
            return f"simctl {sub} needs your leased UDID as the device"
        foreign = [u for u in udids if u not in ios]
        if foreign:
            return f"simctl targets {foreign[0]}, which this session has not leased"
        return None

    if prog == "xcodebuild":
        dests = [rest[i + 1] for i, t in enumerate(rest[:-1]) if t == "-destination"]
        actions = {t for t in rest if not t.startswith("-")}
        for d in dests:
            if "generic/" in d:
                continue
            m = re.search(r"id=([0-9A-Fa-f-]+|\$\{?\w+\}?)", d)
            if m and is_var(m.group(1)):
                if not ios:
                    return "xcodebuild destination uses a variable but this session has no iOS lease"
            elif m:
                if m.group(1) not in ios:
                    return f"xcodebuild destination id={m.group(1)} is not a simulator this session has leased"
            elif "Simulator" in d or "name=" in d:
                return "xcodebuild simulator destinations must use `id=<your leased UDID>`, not a name"
        if not dests and actions & {"test", "test-without-building"}:
            return "xcodebuild test needs `-destination 'id=<your leased UDID>'`"
        return None

    if prog == "emulator":
        if "-list-avds" in rest or "-help" in rest:
            return None
        if "-avd" in rest or any(t.startswith("@") for t in rest):
            return "don't start emulators directly; run `devlease acquire android --wait`"
        return None

    if prog == "flutter":
        sub = next((t for t in rest if not t.startswith("-")), None)
        if sub not in ("run", "install", "drive", "attach", "screenshot", "logs", "test"):
            return None
        device = flag_value(rest, ("-d", "--device-id"))
        if device is None:
            if sub == "test" and not any("integration_test" in t for t in rest):
                return None
            return f"flutter {sub} needs `-d <your leased serial/UDID>`"
        if device == "all":
            return "`flutter -d all` hits every device; pass your leased serial/UDID"
        return check_serial(device, android | ios, protected, "flutter targets")

    if prog == "maestro":
        sub = next((t for t in rest if not t.startswith("-")), None)
        if sub not in ("test", "record", "studio"):
            return None
        device = flag_value(rest, ("--device", "--udid"))
        if device is None:
            return f"maestro {sub} needs `--device <your leased serial/UDID>`"
        return check_serial(device, android | ios, protected, "maestro targets")
    return None


def check_command(command, leased, protected, env=None):
    env = {} if env is None else env
    for segment in split_segments(command):
        reason = check_segment(tokenize(segment), env, leased, protected)
        if reason:
            return reason
    return None


def leased_devices(owner):
    leased = {"android": set(), "ios": set(), "mcp": set()}
    for l in owner_leases(owner):
        if l.get("device"):
            leased[l["platform"]].add(l["device"])
        if l.get("mcp_id"):
            leased["mcp"].add(l["mcp_id"])
    return leased


SHELL_TOOLS = {"bash", "shell", "run_shell_command", "exec_command", "local_shell", "terminal", "execute_command",
               "run_terminal_cmd", "run_command"}


def normalize_payload(data):
    """Hook payloads differ per harness; return (tool_name, tool_input dict, cwd).

    Claude Code, Codex, Gemini CLI, Copilot (Claude-format events) and the OpenCode plugin send
    tool_name + tool_input; Copilot's native camelCase events send toolName + toolArgs (a JSON string).
    """
    tool = data.get("tool_name") or data.get("toolName") or data.get("tool") or ""
    args = data.get("tool_input")
    if args is None:
        args = data.get("toolArgs", data.get("args", data.get("input")))
    if isinstance(args, str):
        try:
            args = json.loads(args)
        except json.JSONDecodeError:
            args = {"command": args}
    if not isinstance(args, dict):
        args = {}
    return str(tool), args, data.get("cwd")


def shell_command(tool, args):
    if tool.lower().rsplit("/", 1)[-1] not in SHELL_TOOLS:
        return None
    cmd = args.get("command", args.get("cmd"))
    if isinstance(cmd, list):
        cmd = shlex.join(str(c) for c in cmd)
    return cmd if isinstance(cmd, str) else None


def server_tool_regex(servers):
    """Tool names of these MCP servers in any agent's naming: mcp__srv__x, mcp_srv_x, srv/x, srv_x, srv-x."""
    alts = "|".join(re.escape(s) for s in servers if s)
    return re.compile(rf"^(?:mcp__?)?(?:{alts})(?:__|[_/.:-])") if alts else None


def is_device_mcp_tool(tool, cfg):
    rx = server_tool_regex(cfg.get("mcp_servers", []))
    return bool(rx and rx.match(tool)) or any(fnmatch.fnmatchcase(tool, p) for p in cfg.get("mcp_tool_patterns", []))


def mcp_tool_device(tool, args, cfg):
    if not is_device_mcp_tool(tool, cfg):
        return None
    for key in cfg.get("mcp_device_args", []):
        if isinstance(args.get(key), str) and args[key]:
            return args[key]
    return None


def block(reason, leased):
    have = ", ".join(f"{p}={d}" for p in ("android", "ios", "mcp") for d in sorted(leased.get(p, ()))) or "none"
    err(f"devlease: blocked: {reason}.\nYour leased devices: {have}. Get one with "
        "`devlease acquire android|ios --wait` and use only the serial/UDID (or MCP device id) it prints.")
    sys.exit(2)


def hook_pretool():
    if os.environ.get("DEVLEASE_HOOK") == "off":
        return 0
    raw = sys.stdin.read()
    if os.environ.get("DEVLEASE_HOOK_LOG"):  # debugging aid: record what the harness sends
        with open(os.environ["DEVLEASE_HOOK_LOG"], "a") as f:
            f.write(raw.strip() + "\n")
    try:
        data = json.loads(raw)
    except ValueError:
        return 0
    if not isinstance(data, dict):
        return 0
    tool, tool_input, cwd = normalize_payload(data)
    cfg = load_config()
    protected = set(cfg.get("protected_serials", []))

    command = shell_command(tool, tool_input)
    if command is not None:
        if not DEVICE_WORDS.search(command):  # cheap pre-filter: most commands never touch a device
            return 0
        leased = leased_devices(current_owner(cwd))
        reason = check_command(command, leased, protected)
        if reason:
            block(reason, leased)
        return 0

    device = mcp_tool_device(tool, tool_input, cfg)
    if device:
        leased = leased_devices(current_owner(cwd))
        if device in protected:
            block(protected_msg(device), leased)
        if device not in leased["android"] | leased["ios"] | leased["mcp"]:
            block(f"MCP device {device} is not leased by this session", leased)
    return 0


def hook_session_end():
    try:
        json.load(sys.stdin)
    except ValueError:
        pass
    pid = agent_pid()
    if pid is None:
        return 0
    # Detach so slow shutdowns aren't cut off by the hook timeout.
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "release", "--owner-pid", str(pid)],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
                     start_new_session=True)
    return 0


# ---------- hook installation per harness ----------

# name: (user file, project file, kind, pre-tool event, matcher, session-end event, timeout)
HARNESSES = {
    "claude": (HOME / ".claude/settings.json", ".claude/settings.json", "settings", "PreToolUse", "Bash|{mcp}",
               "SessionEnd", 10),
    "codex": (HOME / ".codex/hooks.json", ".codex/hooks.json", "settings", "PreToolUse", "^(Bash|{mcp})$",
              "SessionEnd", 10),
    "gemini": (HOME / ".gemini/settings.json", ".gemini/settings.json", "settings", "BeforeTool",
               "run_shell_command|{mcp}", "SessionEnd", 10000),  # Gemini timeouts are in ms
    "copilot": (HOME / ".copilot/hooks/devlease.json", ".github/hooks/devlease.json", "copilot", None, None, None, 10),
    "opencode": (HOME / ".config/opencode/plugins/devlease.js", ".opencode/plugins/devlease.js", "opencode",
                 None, None, None, 15),
}
HARNESS_HOMES = {"claude": HOME / ".claude", "codex": HOME / ".codex", "gemini": HOME / ".gemini",
                 "copilot": HOME / ".copilot", "opencode": HOME / ".config/opencode"}


# How each harness names MCP tools in its hook matcher ({s} = server name).
MCP_MATCHER_FORMS = {"claude": "mcp__{s}__.*", "codex": "mcp__{s}__.*", "gemini": "mcp_{s}_.*"}


def js_regex_escape(s):
    return re.sub(r"([.^$*+?()\[\]{}|\\/])", r"\\\1", s)  # no "\-": invalid in some JS regex modes


def hook_matcher(agent, cfg):
    """The harness matcher: shell tool plus only the configured device MCP servers, never all MCP tools."""
    template = HARNESSES[agent][4]
    forms = [MCP_MATCHER_FORMS[agent].format(s=js_regex_escape(s)) for s in cfg.get("mcp_servers", []) if s]
    if not forms:
        return template.replace("|{mcp}", "")
    return template.replace("{mcp}", "|".join(forms))


def opencode_tool_regex(cfg):
    """JS regex source for the OpenCode plugin's pre-filter (servers + extra globs)."""
    alts = [rf"^{js_regex_escape(s)}[_/.:-]" for s in cfg.get("mcp_servers", []) if s]
    alts += ["^" + js_regex_escape(p).replace("\\*", ".*").replace("\\?", ".") + "$"
             for p in cfg.get("mcp_tool_patterns", []) if p]
    return "|".join(alts) or "$^"


def harness_present(agent):
    return HARNESS_HOMES[agent].is_dir() or bool(shutil.which(agent))


def launcher():
    """The devlease command hooks run: the one on PATH (keeps symlinks, survives upgrades)."""
    return shutil.which("devlease") or os.path.abspath(sys.argv[0])


def hook_file(agent, project):
    return Path(os.getcwd()) / HARNESSES[agent][1] if project else HARNESSES[agent][0]


def is_our_hook(cmd):
    return isinstance(cmd, str) and "devlease" in cmd and re.search(r"\bhook (pretool|session-end)\b", cmd) is not None


def backup(path):
    if path.exists():
        shutil.copy2(path, path.with_name(path.name + ".devlease-backup"))


def strip_settings_hooks(hooks):
    """Remove devlease entries from a Claude-style hooks dict. Returns True if anything changed."""
    changed = False
    for event in list(hooks):
        groups = hooks[event]
        if not isinstance(groups, list):
            continue
        new_groups = []
        for g in groups:
            inner = g.get("hooks") if isinstance(g, dict) else None
            if isinstance(inner, list):
                kept = [h for h in inner if not (isinstance(h, dict) and is_our_hook(h.get("command")))]
                if len(kept) != len(inner):
                    changed = True
                    if not kept:
                        continue
                    g = dict(g, hooks=kept)
            new_groups.append(g)
        if new_groups:
            hooks[event] = new_groups
        else:
            del hooks[event]
    return changed


def opencode_plugin(cmd, cfg):
    return f"""// devlease guard for OpenCode (v2 plugin API). Generated by `devlease hooks install opencode`.
// Blocks bash and device-MCP tool calls that target a device this session has not leased.
import {{ spawnSync }} from "node:child_process"

const DEVLEASE = {json.dumps(cmd)}
// Only shell commands and the configured device MCP servers are checked (`devlease config set mcp_servers ...`).
const DEVICE_MCP = new RegExp({json.dumps(opencode_tool_regex(cfg))})

function check(tool, input) {{
  const r = spawnSync(DEVLEASE, ["hook", "pretool"], {{
    input: JSON.stringify({{ tool_name: tool, tool_input: input ?? {{}}, cwd: process.cwd() }}),
    encoding: "utf8",
    timeout: 15000,
  }})
  if (r.status === 2) throw new Error((r.stderr || "blocked by devlease").trim())
}}

export default {{
  id: "devlease",
  async setup(ctx) {{
    await ctx.tool.hook("execute.before", (event) => {{
      if (event.tool === "bash" || DEVICE_MCP.test(event.tool)) check(event.tool, event.input)
    }})
  }},
}}
"""


def install_hooks(agent, project):
    path = hook_file(agent, project)
    _, _, kind, pre, _, end, timeout = HARNESSES[agent]
    cfg = load_config()
    cmd = shlex.quote(launcher())
    pre_cmd, end_cmd = f"{cmd} hook pretool", f"{cmd} hook session-end"
    path.parent.mkdir(parents=True, exist_ok=True)
    if kind == "settings":
        try:
            data = json.loads(path.read_text() or "{}") if path.exists() else {}
        except json.JSONDecodeError:
            die(f"{path} is not valid JSON; fix it first")
        backup(path)
        hooks = data.setdefault("hooks", {})
        strip_settings_hooks(hooks)
        entry = {"type": "command", "command": pre_cmd, "timeout": timeout}
        end_entry = {"type": "command", "command": end_cmd, "timeout": timeout}
        if agent == "gemini":
            entry["name"], end_entry["name"] = "devlease-guard", "devlease-release"
        hooks.setdefault(pre, []).append({"matcher": hook_matcher(agent, cfg), "hooks": [entry]})
        hooks.setdefault(end, []).append({"hooks": [end_entry]})
        write_json(path, data)
    elif kind == "copilot":
        write_json(path, {"version": 1, "hooks": {
            "PreToolUse": [{"type": "command", "bash": pre_cmd, "timeoutSec": timeout}],
            "SessionEnd": [{"type": "command", "bash": end_cmd, "timeoutSec": timeout}],
        }})
    else:
        path.write_text(opencode_plugin(launcher(), cfg))
    err(f"devlease: installed {agent} hooks in {path}")
    if agent == "codex":
        err("devlease: Codex may ask you to review and trust the new hooks (`/hooks` in Codex)")


def uninstall_hooks(agent, project):
    path = hook_file(agent, project)
    if not path.exists():
        return False
    if HARNESSES[agent][2] == "settings":
        try:
            data = json.loads(path.read_text() or "{}")
        except json.JSONDecodeError:
            err(f"devlease: {path} is not valid JSON; remove the devlease hooks by hand")
            return False
        hooks = data.get("hooks")
        if not isinstance(hooks, dict) or not strip_settings_hooks(hooks):
            return False
        backup(path)
        write_json(path, data)
    else:
        path.unlink()
    err(f"devlease: removed {agent} hooks from {path}")
    return True


def hooks_installed(agent, project):
    path = hook_file(agent, project)
    if not path.exists():
        return False
    if HARNESSES[agent][2] != "settings":
        return True
    try:
        hooks = json.loads(path.read_text() or "{}").get("hooks", {})
    except json.JSONDecodeError:
        return False
    return any(is_our_hook(h.get("command")) for groups in hooks.values() if isinstance(groups, list)
               for g in groups if isinstance(g, dict) for h in g.get("hooks", []) if isinstance(h, dict))


def cmd_hooks(args):
    if args.agent:
        agents = [args.agent]
    elif args.action == "install":
        agents = [a for a in HARNESSES if harness_present(a)]
        if not agents:
            die(f"no supported agent found; pass one of: {', '.join(HARNESSES)}")
        err(f"devlease: installing hooks for detected agents: {', '.join(agents)}")
    else:
        agents = list(HARNESSES)
    for agent in agents:
        if args.action == "install":
            install_hooks(agent, args.project)
        elif args.action == "uninstall":
            if not uninstall_hooks(agent, args.project) and args.agent:
                err(f"devlease: no devlease hooks found for {agent}")
        else:
            state = "installed" if hooks_installed(agent, args.project) else "not installed"
            print(f"{agent}\t{state}\t{hook_file(agent, args.project)}")
    return 0


# ---------- skill / snippet ----------

def share_dir():
    """Where SKILL.md and snippets live: next to the script in a checkout, or <prefix>/share/devlease."""
    here = Path(__file__).resolve().parent
    for d in (here, here.parent / "share/devlease", HOME / ".local/share/devlease"):
        if (d / "skills/devlease/SKILL.md").exists():
            return d
    return None


def skill_targets():
    return {"claude": HOME / ".claude/skills", "agents": HOME / ".agents/skills"}


def cmd_skill(args):
    share = share_dir()
    if args.action == "path":
        if not share:
            die("skill files not found; reinstall devlease")
        print(share / "skills/devlease")
        return 0
    targets = {"custom": Path(args.dir).expanduser()} if args.dir else skill_targets()
    for base in targets.values():
        dest = base / "devlease"
        if args.action == "install":
            if not share:
                die(f"skill files not found; install with `npx skills add {REPO} -g -y` instead")
            if dest.is_symlink() or dest.is_file():
                dest.unlink()
            elif dest.exists():
                shutil.rmtree(dest)
            base.mkdir(parents=True, exist_ok=True)
            shutil.copytree(share / "skills/devlease", dest)
            err(f"devlease: installed skill in {dest}")
        elif dest.is_symlink():
            dest.unlink()
            err(f"devlease: removed skill link {dest}")
        elif dest.exists():
            shutil.rmtree(dest)
            err(f"devlease: removed skill {dest}")
    return 0


def cmd_snippet(args):
    share = share_dir()
    path = share / "snippets/AGENTS.md" if share else None
    if not path or not path.exists():
        die(f"snippet not found; see https://github.com/{REPO}/blob/main/snippets/AGENTS.md")
    sys.stdout.write(path.read_text())
    return 0


# ---------- uninstall ----------

def confirm(question):
    try:
        return input(f"{question} [y/N] ").strip().lower() in ("y", "yes")
    except EOFError:
        return False


UNINSTALL_STEPS = ("devices", "hooks", "skill", "state", "binary")


def cmd_uninstall(args):
    cfg = load_config()
    picked = args.all or any(getattr(args, s) for s in UNINSTALL_STEPS)
    interactive = not picked and not args.dry_run and sys.stdin.isatty()
    if not picked and not args.dry_run and not interactive:
        die("no terminal to ask in: pass --all, or pick steps with --devices --hooks --skill --state --binary "
            "(add --dry-run to only list what would be removed)")
    script = Path(os.path.abspath(sys.argv[0]))
    brew = "/Cellar/" in str(script.resolve())
    checkout = not script.is_symlink() and (script.resolve().parent / ".git").exists()
    share = HOME / ".local/share/devlease"
    sims = sim_devices()
    master_udid = cfg["ios"].get("master_udid")
    sim_targets = [(u, d["name"]) for u, d in sims.items()
                   if u == master_udid or d.get("name") == cfg["ios"]["master_name"] or re.fullmatch(re.escape(SLOT_SIM_PREFIX) + r"\d+", d.get("name", ""))]
    avds = lease_avds(cfg)
    hook_targets, seen = [], set()
    for a in HARNESSES:
        for p in (False, True):
            path = hook_file(a, p).resolve()
            if path not in seen and hooks_installed(a, p):
                seen.add(path)
                hook_targets.append((a, p))
    skill_dirs = [b / "devlease" for b in skill_targets().values()
                  if (b / "devlease").exists() or (b / "devlease").is_symlink()]

    steps = [
        ("devices", "release leases and delete devlease's devices",
         [f"AVD {a}" for a in avds] + [f"simulator {n} ({u})" for u, n in sim_targets]),
        ("hooks", "remove guard hooks", [f"{a}: {hook_file(a, p)}" for a, p in hook_targets]),
        ("skill", "remove the agent skill", [str(d) for d in skill_dirs] or
         (["skills installed with `npx skills` (if any)"] if shutil.which("npx") else [])),
        ("state", "remove config, leases and logs", [str(STATE)] if STATE.exists() else []),
        ("binary", "remove the devlease command",
         [] if checkout else ["installed with Homebrew: run `brew uninstall devlease` yourself"] if brew
         else [str(script) + (" (symlink)" if script.is_symlink() else "")] + ([str(share)] if share.exists() else [])),
    ]
    chosen = {}
    for key, label, items in steps:
        if not items:
            continue
        print(f"{label}:")
        for item in items:
            print(f"  - {item}")
        if args.dry_run:
            continue
        chosen[key] = confirm(f"  {label}?") if interactive else (args.all or getattr(args, key))
    if args.dry_run:
        return 0

    if chosen.get("devices"):
        with state_lock():
            for lease in all_leases():
                stop_device(lease)
                drop_lease(lease)
        for a in avds:
            delete_avd(a)
        for u, _ in sim_targets:
            run(["xcrun", "simctl", "shutdown", u], timeout=60)
            run(["xcrun", "simctl", "delete", u], timeout=60)
        if not chosen.get("state") and CONFIG.exists():
            user = read_user_config()
            user.get("ios", {}).pop("master_udid", None)
            save_user_config(user)
        err("devlease: devices deleted")
    if chosen.get("hooks"):
        for a, p in hook_targets:
            uninstall_hooks(a, p)
    if chosen.get("skill"):
        if shutil.which("npx"):
            run(["npx", "-y", "skills", "remove", "devlease", "-g", "-y"], timeout=180)
        for d in skill_dirs:
            if d.is_symlink():
                d.unlink()
            elif d.exists():
                shutil.rmtree(d)
        err("devlease: skill removed")
    if chosen.get("state"):
        shutil.rmtree(STATE, ignore_errors=True)
        err(f"devlease: removed {STATE}")
    if chosen.get("binary"):
        if brew:
            err("devlease: installed with Homebrew; run `brew uninstall devlease`")
        else:
            script.unlink(missing_ok=True)
            shutil.rmtree(share, ignore_errors=True)
            err(f"devlease: removed {script}")
    return 0


# ---------- main ----------

def main():
    parser = argparse.ArgumentParser(prog="devlease", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--version", action="version", version=f"devlease {__version__}")
    sub = parser.add_subparsers(dest="cmd", required=True, metavar="COMMAND")

    p = sub.add_parser("acquire", help="lease a device; prints its serial/UDID")
    p.add_argument("platform", choices=["android", "ios"])
    p.add_argument("--wait", action="store_true", help="wait for a free slot instead of failing")
    p.add_argument("--timeout", type=int, default=1800, help="max seconds to wait (default 1800)")
    p.set_defaults(fn=cmd_acquire)

    p = sub.add_parser("release", help="stop and discard leased devices")
    p.add_argument("platform", nargs="?", choices=["android", "ios"])
    p.add_argument("--device", help="release this serial/UDID/MCP id, whoever holds it")
    p.add_argument("--owner-pid", type=int, help=argparse.SUPPRESS)
    p.add_argument("--all", action="store_true", help="release every lease")
    p.set_defaults(fn=cmd_release)

    p = sub.add_parser("mine", help="this owner's devices")
    p.add_argument("platform", nargs="?", choices=["android", "ios"])
    p.set_defaults(fn=cmd_mine)

    sub.add_parser("status", help="all slots and who holds them").set_defaults(fn=cmd_status)
    sub.add_parser("reap", help="free stale leases").set_defaults(fn=cmd_reap)

    p = sub.add_parser("init", help="create a fresh master, open it for setup, build slots")
    p.add_argument("platform", choices=["android", "ios"])
    p.add_argument("--force", action="store_true", help="delete an existing master and start fresh")
    p.add_argument("--no-setup", action="store_true", help="skip the manual setup window (clean device)")
    p.set_defaults(fn=cmd_init)

    p = sub.add_parser("edit", help="open the existing master to change its data, then rebuild slots")
    p.add_argument("platform", choices=["android", "ios"])
    p.set_defaults(fn=cmd_edit)

    p = sub.add_parser("rebuild", help="rebuild slot devices from the master")
    p.add_argument("platform", choices=["android", "ios"])
    p.set_defaults(fn=cmd_rebuild)

    p = sub.add_parser("master", help=argparse.SUPPRESS)
    p.add_argument("platform", choices=["android", "ios"])
    p.add_argument("--setup", action="store_true")
    p.set_defaults(fn=cmd_master)

    p = sub.add_parser("config", help="show or change settings")
    p.add_argument("action", nargs="?", choices=["show", "get", "set", "unset", "path"])
    p.add_argument("key", nargs="?")
    p.add_argument("value", nargs="?")
    p.set_defaults(fn=cmd_config)

    sub.add_parser("doctor", help="check prerequisites and setup").set_defaults(fn=cmd_doctor)

    p = sub.add_parser("hook", help="entry point called by agent harness hooks")
    p.add_argument("event", choices=["pretool", "session-end"])
    p.set_defaults(fn=lambda a: hook_pretool() if a.event == "pretool" else hook_session_end())

    p = sub.add_parser("hooks", help="install/uninstall guard hooks for agent harnesses")
    p.add_argument("action", choices=["install", "uninstall", "status"])
    p.add_argument("agent", nargs="?", choices=list(HARNESSES), help="default: every detected agent")
    p.add_argument("--project", action="store_true", help="use the project config in the current directory")
    p.set_defaults(fn=cmd_hooks)

    p = sub.add_parser("skill", help="install the agent skill without npx")
    p.add_argument("action", choices=["install", "uninstall", "path"])
    p.add_argument("--dir", help="skills directory (default: ~/.claude/skills and ~/.agents/skills)")
    p.set_defaults(fn=cmd_skill)

    sub.add_parser("snippet", help="print the AGENTS.md section").set_defaults(fn=cmd_snippet)

    p = sub.add_parser("uninstall", help="remove devices, hooks, skill, state and the binary")
    p.add_argument("--all", action="store_true", help="every step, no questions")
    p.add_argument("--devices", action="store_true", help="delete devlease's AVDs and simulators")
    p.add_argument("--hooks", action="store_true", help="remove guard hooks")
    p.add_argument("--skill", action="store_true", help="remove the agent skill")
    p.add_argument("--state", action="store_true", help="remove the state dir (~/.devlease)")
    p.add_argument("--binary", action="store_true", help="remove the devlease command")
    p.add_argument("--dry-run", action="store_true", help="only list what would be removed")
    p.set_defaults(fn=cmd_uninstall)

    args = parser.parse_args()
    sys.exit(args.fn(args) or 0)


if __name__ == "__main__":
    main()
