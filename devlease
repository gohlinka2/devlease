def parse_value(raw):
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return raw


def cmd_config(args):
    cfg = load_config()
    if args.action in (None, "show"):
        print(json.dumps(cfg, indent=2))
        return 0
    if args.action == "path":
        print(CONFIG)
        return 0
    if not args.key:
        die("config get|set|unset needs a KEY, e.g. `devlease config set android.slots 3`")
    if args.action == "get":
        node = cfg
        for p in args.key.split("."):
            if not isinstance(node, dict) or p not in node:
                die(f"unknown key {args.key}")
            node = node[p]
        print(node if isinstance(node, str) else json.dumps(node))
        return 0
    if args.action == "set":
        if args.value is None:
            die("config set needs a VALUE (JSON or a plain string)")
        if args.key.split(".")[0] not in DEFAULT_CONFIG:
            die(f"unknown key {args.key}; known top-level keys: {', '.join(DEFAULT_CONFIG)}")
        value = parse_value(args.value)
        set_config_value(args.key, value)
        err(f"devlease: {args.key} = {json.dumps(value)}")
        if args.key == "android.slots":
            err("devlease: run `devlease rebuild android` to build the slot AVDs")
        refresh_hooks_if_needed(args.key)
        return 0
    user = read_user_config()  # unset
    node = user
    parts = args.key.split(".")
    for p in parts[:-1]:
        node = node.get(p, {})
    node.pop(parts[-1], None)
    save_user_config(user)
    refresh_hooks_if_needed(args.key)
    return 0


def refresh_hooks_if_needed(key):
    """Hook matchers embed mcp_servers / mcp_tool_patterns, so rewrite installed hooks when those change."""
    if key not in ("mcp_servers", "mcp_tool_patterns"):
        return
    for agent in HARNESSES:
        for project in (False, True):
            if hooks_installed(agent, project):
                install_hooks(agent, project)


